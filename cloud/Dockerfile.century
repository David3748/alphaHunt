FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl rclone zstd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY cloud/requirements-century.txt .
RUN pip install --no-cache-dir -r requirements-century.txt
COPY . .
ENTRYPOINT ["python3", "src/century_pipeline.py"]
CMD ["--config", "config/century.json", "play"]
